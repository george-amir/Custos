[Unit]
Description=Custos Autonomous Behavioral Security Engine & Firewall Bouncer (TypeSafe Jev)
Documentation=https://github.com/george-amir/custos
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/custos
EnvironmentFile=-/etc/custos/custos.env
ExecStart=/usr/local/bin/custos --config /etc/custos/config.toml run
Restart=on-failure
RestartSec=5s

# Hardened Linux capabilities for nftables/ipset kernel enforcement
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
